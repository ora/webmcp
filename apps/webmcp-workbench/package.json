{
  "name": "webmcp-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome side-panel workbench: inspect, run, and lint a page's WebMCP tools.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix ../../packages/webmcp-verify run build",
    "dev": "vite",
    "build": "vite build",
    "e2e": "node scripts/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ora-ai/webmcp-verify": "file:../../packages/webmcp-verify",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@types/chrome": "^0.0.328",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
